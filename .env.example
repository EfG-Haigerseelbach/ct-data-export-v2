# In .env kopieren und nur lokal befüllen. Keine echten Zugangsdaten committen.
# Laden: node --env-file=.env --import tsx src/web/main.ts
CT_BASE_URL=
CT_API_TOKEN=
CT_REQUEST_TIMEOUT_MS=15000
CT_OPERATION_TIMEOUT_MS=60000
CT_MAX_PAGES=100
CT_PAGE_SIZE=100
CT_MAX_RETRIES=2
PORT=3000
# Optionaler Name rechts neben ChurchTools Export; leer blendet ihn aus.
APP_HEADER_LABEL="Meine Gemeinde"
# Optionaler Ordner für die Prüfung externer Exportdateien.
CT_EXPORT_DIRECTORY=var/import
CT_WEB_SECURE_COOKIE=false
APP_PUBLIC_BASE_URL=http://127.0.0.1:3000

# Leer lassen, um SFTP zu deaktivieren. current muss bereits existieren.
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_DIRECTORY=/
SFTP_HOST_FINGERPRINT=
# Genau eine Anmeldemethode verwenden.
SFTP_PASSWORD=
SFTP_PRIVATE_KEY_PATH=
SFTP_PRIVATE_KEY_PASSPHRASE=

# Optionaler Fallback; vollständige Import-URLs über Exportkonfiguration einstellen.
WP_IMPORT_ENDPOINT=
WP_IMPORT_KEY=
